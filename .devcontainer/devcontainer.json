{
  "name": "Minimal Server",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next"
      ]
    }
  },
  "postCreateCommand": "chmod +x start.sh && nohup bash start.sh > server.log 2>&1 &",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Server",
      "onAutoForward": "notify"
    }
  }
}